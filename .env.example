# ======================================================================
# GeoGene - .env.example  (TEMPLATE - luwas i-commit, walay tinuod nga keys)
# Kopyaha kini isip  .env  ug ibutang ang tinuod nga values. Ang  .env  DILI i-commit.
# ======================================================================

DB_HOST=localhost
DB_NAME=geogene_db
DB_USER=root
DB_PASS=

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login@smtp-brevo.com
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM_NAME=GeoGene
SMTP_FROM_EMAIL=your-verified-sender@example.com

GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Optional - taas ug random nga text (usba LANG kung wala pa kay data sa verified IDs)
# ID_VERIFY_PEPPER=
